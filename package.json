{
  "name": "azure-cli-context",
  "displayName": "Azure CLI Context",
  "description": "Shows Azure CLI user and subscription in status bar with account switching",
  "version": "0.1.0",
  "publisher": "jcallaghan",
  "author": {
    "name": "James Callaghan"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jcallaghan/vscode-cli-context-az.git"
  },
  "bugs": {
    "url": "https://github.com/jcallaghan/vscode-cli-context-az/issues"
  },
  "homepage": "https://github.com/jcallaghan/vscode-cli-context-az#readme",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0078D4",
    "theme": "dark"
  },
  "keywords": [
    "azure",
    "azure-cli",
    "subscription",
    "account",
    "context"
  ],
  "engines": {
    "vscode": "^1.107.0",
    "node": ">=22.14.0"
  },
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Azure CLI Context executes the Azure CLI and can change the account used by other tools. Trust the workspace to enable it."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Azure CLI Context requires an extension host with a filesystem and an installed Azure CLI."
    }
  },
  "categories": [
    "Azure",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Azure CLI Context",
      "properties": {
        "azure-cli-context.showSubscriptionName": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Show subscription names in the status bar, tooltip and account menu."
        },
        "azure-cli-context.showUser": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Show the Azure CLI user identity in the tooltip and account menu."
        },
        "azure-cli-context.showSubscriptionId": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Show subscription IDs in the tooltip and account menu."
        },
        "azure-cli-context.showTenantId": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Show tenant IDs in the tooltip and account menu. Hiding details does not disable explicit copy commands."
        }
      }
    },
    "commands": [
      {
        "command": "azure-cli-context.showAccountMenu",
        "title": "Show Azure Account Menu",
        "category": "Azure CLI Context",
        "icon": "$(azure)"
      },
      {
        "command": "azure-cli-context.refresh",
        "title": "Refresh Azure Account",
        "category": "Azure CLI Context",
        "icon": "$(refresh)"
      },
      {
        "command": "azure-cli-context.login",
        "title": "Login to Azure CLI",
        "category": "Azure CLI Context",
        "icon": "$(sign-in)"
      },
      {
        "command": "azure-cli-context.logout",
        "title": "Logout from Azure CLI",
        "category": "Azure CLI Context",
        "icon": "$(sign-out)"
      },
      {
        "command": "azure-cli-context.switchSubscription",
        "title": "Switch Azure Subscription",
        "category": "Azure CLI Context",
        "icon": "$(list-unordered)"
      },
      {
        "command": "azure-cli-context.copySubscriptionId",
        "title": "Copy Subscription ID",
        "category": "Azure CLI Context",
        "icon": "$(copy)"
      },
      {
        "command": "azure-cli-context.copyTenantId",
        "title": "Copy Tenant ID",
        "category": "Azure CLI Context",
        "icon": "$(copy)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile && npm run test:unit",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vscode-test",
    "test:unit": "npm run compile-tests && cd test && node --test",
    "vsix": "vsce package",
    "verify:vsix": "node scripts/verify-vsix.cjs"
  },
  "overrides": {
    "@vscode/test-cli": {
      "mocha": "^12.0.3"
    }
  },
  "devDependencies": {
    "@types/vscode": "1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.48.1",
    "eslint": "^9.39.1",
    "esbuild": "^0.27.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0"
  }
}
